{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/task.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "workflow_stage_id",
    "priority",
    "owner",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^task_" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "workflow_stage_id": { "type": "string", "pattern": "^stage_" },
    "priority": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "owner": { "type": ["string", "null"], "pattern": "^member_[0-9]{2}$" },
    "reviewer": { "type": ["string", "null"], "pattern": "^member_[0-9]{2}$" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "READY",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "NEEDS_REVIEW"
      ]
    },
    "start_date": { "type": ["string", "null"] },
    "due_date": { "type": ["string", "null"] },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^task_" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": { "type": "string" },
          "reference": { "type": "string" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_dataset_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dataset_" },
      "uniqueItems": true
    },
    "related_period_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^period_" },
      "uniqueItems": true
    },
    "related_product": {
      "type": ["string", "null"]
    },
    "completed_date": { "type": ["string", "null"] },
    "last_updated": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
