{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/run.schema.json",
  "type": "object",
  "required": [
    "id",
    "period_id",
    "attempt_number",
    "simulation_start",
    "simulation_end",
    "execution_status",
    "owner"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^run_" },
    "period_id": { "type": "string", "pattern": "^period_" },
    "attempt_number": { "type": "integer", "minimum": 1 },
    "simulation_start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "simulation_end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "owner": { "type": ["string", "null"], "pattern": "^member_[0-9]{2}$" },
    "configuration_id": { "type": ["string", "null"] },
    "hpc_user": { "type": ["string", "null"] },
    "partition": { "type": ["string", "null"] },
    "job_id": { "type": ["string", "null"] },
    "submission_time": { "type": ["string", "null"] },
    "execution_start_time": { "type": ["string", "null"] },
    "execution_end_time": { "type": ["string", "null"] },
    "execution_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "READY",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "exit_code": { "type": ["integer", "null"] },
    "log_locations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "restart_checkpoint": { "type": ["string", "null"] },
    "failure_info": { "type": ["string", "null"] },
    "retry_of": { "type": ["string", "null"], "pattern": "^run_" },
    "source_revisions": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "input_dataset_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dataset_" }
    },
    "output_dataset_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dataset_" }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "NOT_VALIDATED",
        "NEEDS_REVIEW",
        "VERIFIED",
        "ACCEPTED",
        "FAILED_VALIDATION",
        "UNKNOWN"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": { "type": "string" },
          "reference": { "type": "string" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
