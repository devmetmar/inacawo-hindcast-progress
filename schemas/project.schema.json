{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/project.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "objective",
    "status",
    "project_owner",
    "team_member_ids",
    "scope",
    "completion_criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^proj_" },
    "name": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["PLANNING", "ACTIVE", "BLOCKED", "COMPLETED", "ARCHIVED"]
    },
    "project_owner": { "type": "string", "pattern": "^member_[0-9]{2}$" },
    "team_member_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^member_[0-9]{2}$" },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "required": ["confirmed", "provisional", "notes"],
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "type": ["object", "null"],
          "required": ["historical", "remaining", "confirmed_date", "confirmed_by"],
          "additionalProperties": false,
          "properties": {
            "historical": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
              }
            },
            "remaining": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
              }
            },
            "confirmed_date": { "type": "string" },
            "confirmed_by": { "type": "string" }
          }
        },
        "provisional": {
          "type": "object",
          "required": ["historical_claimed", "remaining_claimed"],
          "additionalProperties": false,
          "properties": {
            "historical_claimed": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
              }
            },
            "remaining_claimed": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
              }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "completion_criteria": {
      "type": "object",
      "required": [
        "require_execution_verified",
        "require_outputs_verified",
        "require_validations_verified",
        "require_human_acceptance",
        "required_products"
      ],
      "additionalProperties": false,
      "properties": {
        "require_execution_verified": { "type": "boolean" },
        "require_outputs_verified": { "type": "boolean" },
        "require_validations_verified": { "type": "boolean" },
        "require_human_acceptance": { "type": "boolean" },
        "required_products": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ocean2d", "ocean3d", "wrf2d", "wrf3d", "restarts"]
          },
          "uniqueItems": true
        }
      }
    },
    "hpc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_user": { "type": "string" },
        "historical_user": { "type": "string" },
        "work_base": { "type": "string" },
        "historical_base": { "type": "string" },
        "scheduler": { "type": "string" }
      }
    },
    "hpc_snapshot_ttl_hours": {
      "type": "number",
      "minimum": 1,
      "description": "Snapshots older than this many hours are STALE at read/display time."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
