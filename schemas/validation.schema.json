{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/validation.schema.json",
  "type": "object",
  "required": [
    "id",
    "method",
    "pass_fail_status",
    "reviewer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^val_" },
    "dataset_id": { "type": ["string", "null"], "pattern": "^dataset_" },
    "run_id": { "type": ["string", "null"], "pattern": "^run_" },
    "period_id": { "type": ["string", "null"], "pattern": "^period_" },
    "method": { "type": "string", "minLength": 1 },
    "expected_result": { "type": ["string", "null"] },
    "actual_result": { "type": ["string", "null"] },
    "threshold_definition": {
      "type": ["string", "null"],
      "description": "Must be owner-supplied; never invent scientific thresholds."
    },
    "pass_fail_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_VERIFIED", "NOT_RUN"]
    },
    "reviewer": { "type": ["string", "null"], "pattern": "^member_[0-9]{2}$" },
    "validation_date": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": { "type": "string" },
          "reference": { "type": "string" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
