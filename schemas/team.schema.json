{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/team.schema.json",
  "type": "object",
  "required": ["members"],
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "role", "active"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^member_[0-9]{2}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "active": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
