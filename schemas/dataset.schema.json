{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inacawo.local/schemas/dataset.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "origin",
    "location",
    "integrity_status",
    "validation_status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^dataset_" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "origin": {
      "type": "string",
      "enum": ["cls_brazil", "internal", "shared_input", "unknown"]
    },
    "product": {
      "type": ["string", "null"],
      "enum": [
        "ocean2d",
        "ocean3d",
        "wrf2d",
        "wrf3d",
        "raw_output",
        "run_dirs",
        "era5",
        "forcing",
        "validation",
        "other",
        null
      ]
    },
    "period_coverage": {
      "type": ["object", "null"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "basis": {
          "type": "string",
          "enum": ["directory_names", "reported", "verified", "unknown"]
        }
      }
    },
    "location": { "type": "string", "minLength": 1 },
    "file_count": { "type": ["integer", "null"], "minimum": 0 },
    "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "size_human": { "type": ["string", "null"] },
    "manifest_ref": { "type": ["string", "null"] },
    "checksum_ref": { "type": ["string", "null"] },
    "integrity_status": {
      "type": "string",
      "enum": ["UNKNOWN", "NOT_VERIFIED", "VERIFIED", "FAILED"]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "NOT_VALIDATED",
        "NEEDS_REVIEW",
        "VERIFIED",
        "ACCEPTED",
        "FAILED_VALIDATION",
        "UNKNOWN"
      ]
    },
    "lifecycle_status": {
      "type": ["string", "null"],
      "enum": [
        "EXPECTED",
        "CREATED",
        "CATALOGUED",
        "VERIFIED",
        "ACCEPTED",
        "MISSING",
        "INCOMPLETE",
        "BLOCKED",
        "NOT_VERIFIED",
        "UNKNOWN",
        null
      ],
      "description": "Optional explicit lifecycle. If null, dashboard derives a conservative status from evidenced fields only."
    },
    "owner": { "type": ["string", "null"], "pattern": "^member_[0-9]{2}$" },
    "created_at": {
      "type": ["string", "null"],
      "description": "Scientific/output creation date only when evidenced. Never invent from mtime alone."
    },
    "created_at_provenance": { "type": ["string", "null"] },
    "catalogued_at": {
      "type": ["string", "null"],
      "description": "When this dataset record was registered in the tracking catalog."
    },
    "verified_at": { "type": ["string", "null"] },
    "accepted_at": { "type": ["string", "null"] },
    "last_inventory_scan": { "type": ["string", "null"] },
    "related_task_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^task_" },
      "uniqueItems": true
    },
    "notes": { "type": ["string", "null"] }
  }
}
